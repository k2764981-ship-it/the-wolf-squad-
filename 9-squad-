
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>9 SQUAD | Official</title>
<style>
:root{--black:#080808;--maroon:#5B1018;--gold:#B49A72}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--black);color:#fff;font-family:Arial,sans-serif}
nav{position:sticky;top:0;z-index:5;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:15px 5%;background:#100b0b;border-bottom:1px solid var(--maroon)}
.logo{font-size:23px;font-weight:900;letter-spacing:3px;color:var(--gold)}
nav a{color:#eee;text-decoration:none;font-size:12px;margin-left:12px}
.hero{min-height:70vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:35px 15px;background:radial-gradient(ellipse at center,#431017 0%,#16090b 48%,#080808 82%)}
.main-logo{width:min(230px,58vw);aspect-ratio:1;object-fit:contain;filter:drop-shadow(0 0 18px #5b101866);margin-bottom:18px}
.hero h1{font-size:clamp(40px,10vw,76px);letter-spacing:7px;color:var(--gold)}
.hero h2{font-size:clamp(14px,3vw,21px);letter-spacing:3px;margin:12px 0}
.hero p{color:var(--gold);letter-spacing:3px}
.btn{display:inline-block;background:var(--maroon);color:white;padding:13px 24px;border:1px solid var(--gold);border-radius:5px;text-decoration:none;margin-top:22px;font-weight:bold}
section{padding:58px 6%;text-align:center}
.heading{color:var(--gold);font-size:29px;margin-bottom:28px}
.owners,.members{display:grid;grid-template-columns:repeat(auto-fit,minmax(155px,1fr));gap:17px;max-width:900px;margin:auto}
.card{background:linear-gradient(145deg,#211416,#100d0d);border:1px solid #70452e;padding:20px 13px;border-radius:11px}
.profile{width:112px;height:112px;object-fit:cover;border-radius:50%;border:2px solid var(--gold);margin:0 auto 14px;display:block;background:#191313}
.card h3{color:var(--gold);margin-bottom:7px}
.card p{color:#bbb;font-size:13px}
.vip{color:var(--gold)!important;font-weight:bold}
.member-number{font-size:23px;color:var(--gold);margin-bottom:8px}
form{max-width:620px;margin:auto;background:#120d0e;border:1px solid #70452e;padding:24px;border-radius:12px;text-align:left}
form h3{color:var(--gold);margin:24px 0 13px}
label{display:block;color:#ddd;margin:13px 0 7px;font-size:14px}
input,select,textarea{width:100%;padding:12px;background:#21191a;color:white;border:1px solid #533038;border-radius:5px;outline:none}
input:focus,select:focus,textarea:focus{border-color:var(--gold)}
textarea{min-height:70px;resize:vertical}
.consent{display:flex;align-items:flex-start;gap:10px;margin-top:18px;line-height:1.5}
.consent input{width:auto;margin-top:4px}
.submit{width:100%;padding:15px;margin-top:22px;background:var(--maroon);color:white;border:1px solid var(--gold);border-radius:5px;font-weight:bold;font-size:15px;cursor:pointer}
footer{text-align:center;padding:28px 10px;background:#110b0c;border-top:1px solid var(--maroon);color:var(--gold);line-height:2}
.small{font-size:12px;color:#aaa;margin-top:10px}
@media(max-width:520px){nav{padding:13px 3%;flex-wrap:wrap}.logo{font-size:19px}nav a{font-size:10px;margin-left:7px}section{padding:45px 14px}form{padding:17px}}
</style>
</head>
<body>
<nav>
  <div class="logo">9 SQUAD 💀</div>
  <div><a href="#home">HOME</a><a href="#owners">OWNERS</a><a href="#members">MEMBERS</a><a href="#join">JOIN</a></div>
</nav>

<header class="hero" id="home">
  <img class="main-logo" src="9squad-assets/main-logo.png" alt="9 SQUAD official logo">
  <h1>9 SQUAD</h1>
  <h2>💀 NO FEAR • NO LIMITS ⚡</h2>
  <p>DARK GANGSTER LUXURY</p>
  <a class="btn" href="#join">JOIN THE SQUAD</a>
</header>

<section id="owners">
  <h2 class="heading">👑 OWNER VIP BOARD</h2>
  <div class="owners">
    <article class="card">
      <img class="profile" src="9squad-assets/owner-9999-logo.png" alt="9999 owner logo">
      <h3>9999 👤</h3><p class="vip">MAIN OWNER 👑</p><p>9 SQUAD</p>
    </article>
    <article class="card">
      <img class="profile" src="9squad-assets/wolfy-logo.png" alt="WOLFY second owner logo">
      <h3>WOLFY 🐺</h3><p class="vip">SECOND OWNER</p><p>9 SQUAD</p>
    </article>
  </div>
</section>

<section id="members">
  <h2 class="heading">💀 OFFICIAL MEMBERS</h2>
  <div class="members" id="memberList"></div>
</section>

<section id="join">
  <h2 class="heading">⚡ JOIN 9 SQUAD</h2>
  <form id="application">
    <h3>📝 PERSONAL DETAILS / පෞද්ගලික විස්තර</h3>
    <label>Full Name / සම්පූර්ණ නම</label><input name="fullname" required>
    <label>Name with Initials / මුලකුරු සමඟ නම</label><input name="initials">
    <label>Age Range / වයස් කාණ්ඩය</label>
    <select name="age" required><option value="">Select / තෝරන්න</option><option>13-15</option><option>16-17</option><option>18+</option></select>
    <label>Gender / ස්ත්‍රී - පුරුෂ (Optional)</label>
    <select name="gender"><option value="">Select</option><option>Male / පුරුෂ</option><option>Female / ස්ත්‍රී</option><option>Prefer not to say</option></select>
    <label>Nearest City / ළඟම නගරය</label><input name="city" required>

    <h3>📱 SOCIAL MEDIA DETAILS</h3>
    <label>TikTok Page Name / TikTok නම</label><input name="tiktok" required>
    <label>Number of Pages / Pages ගණන</label><input name="pages" type="number" min="0">
    <label>Page Names / Pages වල නම්</label><textarea name="pagenames"></textarea>

    <h3>🐺 SQUAD DETAILS</h3>
    <label>Previous Squads / කලින් හිටපු Squads</label><textarea name="previous"></textarea>
    <label>Agree with Rules? / Rules වලට එකඟද?</label>
    <select name="rules" required><option value="">Select</option><option>Yes / ඔව්</option><option>No / නැහැ</option></select>

    <h3>📌 ADDITIONAL DETAILS</h3>
    <label>Phone Number (Optional) / දුරකථන අංකය</label><input name="phone" type="tel">
    <p class="small">Do not enter your full home address or other sensitive personal information.</p>
    <div class="consent"><input type="checkbox" id="consent" required><label for="consent">I agree to share these details with 9 SQUAD for membership review. / සාමාජිකත්වය සලකා බැලීම සඳහා මෙම තොරතුරු ලබාදීමට එකඟ වෙමි.</label></div>
    <button class="submit" type="submit">SUBMIT APPLICATION 💀⚡</button>
  </form>
</section>

<footer>
  <h2>9 SQUAD 💀⚡</h2>
  <p>NO FEAR • NO LIMITS</p>
  <p>ONE TEAM • ONE FAMILY 👑</p>
  <p>© 2026 9 SQUAD</p>
</footer>

<script>
const memberList=document.getElementById("memberList");
for(let i=1;i<=20;i++){
  const n=String(i).padStart(2,"0");
  memberList.insertAdjacentHTML("beforeend",`
    <article class="card">
      <div class="member-number">MEMBER ${n}</div>
      <h3>9 SQUAD</h3><p>MEMBER 💀⚡</p>
    </article>`);
}
document.getElementById("application").addEventListener("submit",function(e){
  e.preventDefault();
  const f=new FormData(this);
  if(f.get("rules")!=="Yes / ඔව්"){
    alert("Please agree to the squad rules / Rules වලට එකඟ වන්න.");
    return;
  }
  const message=`💀 9 SQUAD APPLICATION ⚡

📝 PERSONAL DETAILS
Name: ${f.get("fullname")}
Initials: ${f.get("initials")}
Age Range: ${f.get("age")}
Gender: ${f.get("gender")}
City: ${f.get("city")}

📱 SOCIAL MEDIA
TikTok: ${f.get("tiktok")}
Pages: ${f.get("pages")}
Page Names: ${f.get("pagenames")}

🐺 SQUAD DETAILS
Previous Squads: ${f.get("previous")}
Rules: ${f.get("rules")}

📌 CONTACT
Phone: ${f.get("phone")}

ONE TEAM • ONE FAMILY 👑`;
  const url="https://wa.me/94764389067?text="+encodeURIComponent(message);
  window.open(url,"_blank");
});
</script>
</body>
</html>
